{"metadata":{"modules":[{"name":"MetalFFT"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"YINDetector"}],"role":"symbol","externalID":"s:8MetalFFT11YINDetectorC","roleHeading":"Class","title":"YINDetector","navigatorTitle":[{"kind":"identifier","text":"YINDetector"}],"symbolKind":"class"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"YINDetector","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"YIN works in the "},{"type":"strong","inlineContent":[{"type":"text","text":"time domain"}]},{"type":"text","text":", on the samples themselves, and this is why"},{"type":"text","text":" "},{"type":"text","text":"it is here alongside the spectral tools rather than built out of them. A"},{"type":"text","text":" "},{"type":"text","text":"magnitude spectrum locates "},{"type":"emphasis","inlineContent":[{"type":"text","text":"partials"}]},{"type":"text","text":"; which partial is the fundamental is"},{"type":"text","text":" "},{"type":"text","text":"then an inference, and the inference is what goes wrong — a bin is 11.7 Hz"},{"type":"text","text":" "},{"type":"text","text":"wide at a 4096-point transform on 48 kHz, which is most of a semitone down"},{"type":"text","text":" "},{"type":"text","text":"where a bass string lives, and a microphone that rolls off the fundamental"},{"type":"text","text":" "},{"type":"text","text":"leaves the loudest peak an octave above the note. YIN never asks the"},{"type":"text","text":" "},{"type":"text","text":"question: it measures how long the waveform takes to repeat, which is the"},{"type":"text","text":" "},{"type":"text","text":"pitch by definition, and resolves that period to a fraction of a sample."}],"type":"paragraph"},{"inlineContent":[{"text":"The four steps are the paper’s, in order:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Difference function"}],"type":"strong"},{"type":"text","text":" "},{"code":"d(τ) = Σ(x[j] − x[j+τ])²","type":"codeVoice"},{"type":"text","text":" — how badly the window"},{"type":"text","text":" "},{"type":"text","text":"fails to match itself τ samples later."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Cumulative mean normalisation"}],"type":"strong"},{"text":" — divide each ","type":"text"},{"code":"d(τ)","type":"codeVoice"},{"text":" by the running mean","type":"text"},{"text":" ","type":"text"},{"text":"of everything below it. Without this, ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" falls off with τ and the search","type":"text"},{"text":" ","type":"text"},{"text":"drifts to long lags; with it, the first deep dip is the period.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Absolute threshold"}]},{"type":"text","text":" — take the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"first"}]},{"type":"text","text":" dip below the threshold, not"},{"type":"text","text":" "},{"type":"text","text":"the deepest. Taking the deepest is what produces octave-down errors,"},{"type":"text","text":" "},{"type":"text","text":"since twice the period always matches too. A dip, not merely a lag under"},{"type":"text","text":" "},{"type":"text","text":"the threshold: the curve has to be falling as well, or a partial above"},{"type":"text","text":" "},{"type":"codeVoice","code":"maxFrequency"},{"type":"text","text":" gets accepted on its way back up."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Parabolic interpolation","type":"text"}],"type":"strong"},{"text":" around that lag, so the period is not","type":"text"},{"text":" ","type":"text"},{"text":"quantised to whole samples. At 48 kHz an E2 period is 582 samples and one","type":"text"},{"text":" ","type":"text"},{"text":"sample is 3 cents, so this step is the difference between a tuner and a","type":"text"},{"text":" ","type":"text"},{"text":"note-namer.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Step 1 is the expensive one — quadratic if written directly. It is computed"},{"type":"text","text":" "},{"type":"text","text":"here from the autocorrelation instead, using"},{"type":"text","text":" "},{"type":"codeVoice","code":"d(τ) = p(0) + p(τ) − 2·r(τ)"},{"type":"text","text":", where "},{"type":"codeVoice","code":"p(τ)"},{"type":"text","text":" is the energy of the window"},{"type":"text","text":" "},{"type":"text","text":"starting at τ (a running sum, O(1) per lag) and "},{"type":"codeVoice","code":"r(τ)"},{"text":" the correlation at","type":"text"},{"text":" ","type":"text"},{"text":"lag τ. Each ","type":"text"},{"code":"r(τ)","type":"codeVoice"},{"text":" is a single ","type":"text"},{"code":"vDSP_dotpr","type":"codeVoice"},{"text":", so the inner loop is one","type":"text"},{"text":" ","type":"text"},{"text":"vectorised call per lag rather than three, and no temporary buffers are","type":"text"},{"text":" ","type":"text"},{"text":"touched at all.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That inner loop still costs "},{"type":"codeVoice","code":"lags × window"},{"type":"text","text":", and both halves of that product"},{"type":"text","text":" "},{"type":"text","text":"shrink under decimation, so steps 1–3 run on a low-passed copy at a quarter"},{"type":"text","text":" "},{"type":"text","text":"of the sample rate — sixteen times less work — and only step 4 returns to"},{"type":"text","text":" "},{"type":"text","text":"the full rate, recomputing "},{"type":"codeVoice","code":"d(τ)"},{"type":"text","text":" across the handful of lags around the"},{"type":"text","text":" "},{"type":"text","text":"coarse answer. Precision is set entirely by that second stage, so nothing is"},{"type":"text","text":" "},{"type":"text","text":"given up for the speed: the decimated pass only has to land within a couple"},{"type":"text","text":" "},{"type":"text","text":"of samples of the period, which is what it is good at. When the frequency"},{"type":"text","text":" "},{"type":"text","text":"range or the window is too small for a clean decimation the factor falls to"},{"type":"text","text":" "},{"type":"text","text":"1 and the coarse pass is simply the exact one."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Allocation-free after "},{"code":"init","type":"codeVoice"},{"type":"text","text":". Not thread-safe: one detector per thread, or"},{"type":"text","text":" "},{"type":"text","text":"serialise calls."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/metalfft\/yindetector"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"type":"text","text":"Monophonic pitch detection by the YIN algorithm of de Cheveigné and"},{"type":"text","text":" "},{"type":"text","text":"Kawahara (2002)."}],"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector\/init(sampleRate:bufferSize:minFrequency:maxFrequency:threshold:rmsThreshold:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector\/bufferSize","doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector\/maxFrequency","doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector\/minFrequency","doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector\/rmsThreshold","doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector\/sampleRate","doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector\/threshold"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector\/detect(_:)-2mh5","doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector\/detect(_:)-35ya0"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/MetalFFT\/documentation\/MetalFFT"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector"},"sections":[],"references":{"doc://MetalFFT/documentation/MetalFFT":{"identifier":"doc:\/\/MetalFFT\/documentation\/MetalFFT","type":"topic","title":"MetalFFT","role":"collection","url":"\/documentation\/metalfft","abstract":[],"kind":"symbol"},"doc://MetalFFT/documentation/MetalFFT/YINDetector/init(sampleRate:bufferSize:minFrequency:maxFrequency:threshold:rmsThreshold:)":{"title":"init(sampleRate:bufferSize:minFrequency:maxFrequency:threshold:rmsThreshold:)","url":"\/documentation\/metalfft\/yindetector\/init(samplerate:buffersize:minfrequency:maxfrequency:threshold:rmsthreshold:)","role":"symbol","type":"topic","abstract":[],"identifier":"doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector\/init(sampleRate:bufferSize:minFrequency:maxFrequency:threshold:rmsThreshold:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"sampleRate"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"bufferSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"minFrequency"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxFrequency"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"},{"kind":"text","text":", "},{"kind":"externalParam","text":"threshold"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"},{"kind":"text","text":", "},{"kind":"externalParam","text":"rmsThreshold"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"},{"kind":"text","text":")"}],"kind":"symbol"},"doc://MetalFFT/documentation/MetalFFT/YINDetector/threshold":{"abstract":[{"text":"Normalised-difference level a lag must dip below to be taken as the","type":"text"},{"text":" ","type":"text"},{"text":"period. The paper suggests 0.1; 0.15 is a little more willing, which","type":"text"},{"text":" ","type":"text"},{"text":"suits a plucked string whose harmonic content shifts as it decays.","type":"text"}],"identifier":"doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector\/threshold","url":"\/documentation\/metalfft\/yindetector\/threshold","role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"threshold"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"}],"title":"threshold"},"doc://MetalFFT/documentation/MetalFFT/YINDetector/detect(_:)-35ya0":{"url":"\/documentation\/metalfft\/yindetector\/detect(_:)-35ya0","identifier":"doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector\/detect(_:)-35ya0","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"detect"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8MetalFFT11YINEstimateV","text":"YINEstimate"},{"kind":"text","text":"?"}],"title":"detect(_:)","abstract":[{"type":"text","text":"Estimate the pitch of one window. Returns nil when the window is below"},{"type":"text","text":" "},{"type":"text","text":"the level gate or holds no usable lag at all."}],"kind":"symbol","type":"topic","role":"symbol"},"doc://MetalFFT/documentation/MetalFFT/YINDetector/minFrequency":{"url":"\/documentation\/metalfft\/yindetector\/minfrequency","identifier":"doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector\/minFrequency","kind":"symbol","role":"symbol","abstract":[],"title":"minFrequency","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"minFrequency"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"}],"type":"topic"},"doc://MetalFFT/documentation/MetalFFT/YINDetector/detect(_:)-2mh5":{"url":"\/documentation\/metalfft\/yindetector\/detect(_:)-2mh5","type":"topic","abstract":[],"identifier":"doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector\/detect(_:)-2mh5","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"detect"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SR","text":"UnsafeBufferPointer"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8MetalFFT11YINEstimateV","text":"YINEstimate"},{"kind":"text","text":"?"}],"title":"detect(_:)","kind":"symbol","role":"symbol"},"doc://MetalFFT/documentation/MetalFFT/YINDetector/sampleRate":{"title":"sampleRate","identifier":"doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector\/sampleRate","role":"symbol","kind":"symbol","url":"\/documentation\/metalfft\/yindetector\/samplerate","abstract":[{"text":"Sample rate the windows arrive at.","type":"text"}],"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sampleRate","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}]},"doc://MetalFFT/documentation/MetalFFT/YINDetector/rmsThreshold":{"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/metalfft\/yindetector\/rmsthreshold","abstract":[{"type":"text","text":"Windows quieter than this are not analysed at all. The single most"},{"type":"text","text":" "},{"type":"text","text":"effective thing in the whole class: a detector asked to find a pitch in"},{"type":"text","text":" "},{"type":"text","text":"room noise will always find one."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rmsThreshold"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Float","preciseIdentifier":"s:Sf"}],"title":"rmsThreshold","identifier":"doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector\/rmsThreshold"},"doc://MetalFFT/documentation/MetalFFT/YINDetector/bufferSize":{"abstract":[{"text":"Window length in samples. Must be at least twice the longest period to","type":"text"},{"text":" ","type":"text"},{"text":"be detected — the difference function compares the first half of the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"window against every offset into the second."}],"identifier":"doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector\/bufferSize","title":"bufferSize","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bufferSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"kind":"symbol","type":"topic","url":"\/documentation\/metalfft\/yindetector\/buffersize"},"doc://MetalFFT/documentation/MetalFFT/YINDetector":{"navigatorTitle":[{"text":"YINDetector","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/metalfft\/yindetector","abstract":[{"type":"text","text":"Monophonic pitch detection by the YIN algorithm of de Cheveigné and"},{"type":"text","text":" "},{"type":"text","text":"Kawahara (2002)."}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"YINDetector","kind":"identifier"}],"identifier":"doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector","title":"YINDetector"},"doc://MetalFFT/documentation/MetalFFT/YINDetector/maxFrequency":{"abstract":[],"url":"\/documentation\/metalfft\/yindetector\/maxfrequency","kind":"symbol","role":"symbol","identifier":"doc:\/\/MetalFFT\/documentation\/MetalFFT\/YINDetector\/maxFrequency","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxFrequency","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Float","kind":"typeIdentifier","preciseIdentifier":"s:Sf"}],"title":"maxFrequency"}}}